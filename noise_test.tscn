[gd_scene load_steps=5 format=3 uid="uid://c41g0h0qeo483"]

[sub_resource type="GDScript" id="GDScript_bwinv"]
script/source = "extends Control

var _WIDTH = 2560
var _HEIGHT = 1440

var _SCALE = 4

var world: WorldGen
var image: Image

var generating: bool = false
var finished_image: Image = null

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	_regenerate_map()

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _physics_process(delta: float) -> void:
	if finished_image != null:
		$TextureRect.texture = ImageTexture.create_from_image(image)
		$Label.text = \"Done\"
		finished_image = null
		generating = false

func _generate_map_section(y: int):
	for x in range(0, _WIDTH):
		var sample_value = world.sample_point((x - _WIDTH/2) * _SCALE, (y - _HEIGHT/2) * _SCALE)
		var sample_colour = world.color_hex(sample_value)
		image.set_pixel(x, y, sample_colour)

func _regenerate_map():
	world = WorldGen.new()
	image = Image.create_empty(_WIDTH, _HEIGHT, false, Image.Format.FORMAT_RGB8)
	
	var group_task_id = WorkerThreadPool.add_group_task(_generate_map_section, _HEIGHT)
	
	WorkerThreadPool.wait_for_group_task_completion(group_task_id)
	
	finished_image = image

func _unhandled_key_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"reload_map\") and not generating:
		$Label.text = \"Generating..\"
		generating = true
		WorkerThreadPool.add_task(_regenerate_map.bind())
"

